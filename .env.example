# ==============================================================================
# Vélure Atelier — Environment Configuration (.env.example)
#
# IMPORTANT:
# 1. Copy this file to .env.local for local development:
#    cp .env.example .env.local
# 2. Never commit actual secret keys or .env.local to version control.
# 3. Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# 4. Variables without NEXT_PUBLIC_ are strictly server-only.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend & Database
# ------------------------------------------------------------------------------
# Your Supabase project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase public anonymous API key (safe for browser usage with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase Service Role Key (SERVER-ONLY - Bypasses Row Level Security)
# Used exclusively for background workers, payment webhooks, and admin operations.
# NEVER expose this key to client components or prefix with NEXT_PUBLIC_!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# Direct PostgreSQL database connection URL (Used for CLI migrations and scripts)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. Application & Site URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. Payment Gateway Integration (Razorpay or Stripe)
# ------------------------------------------------------------------------------
# Razorpay Configuration (Standard for Indian D2C E-commerce):
# Client-safe Key ID:
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# Server-only Razorpay Secret Key:
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_placeholder

# Server-only Webhook Secret (used to cryptographically verify incoming payment events):
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_placeholder

# Alternative: Stripe Configuration
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
# STRIPE_SECRET_KEY=sk_test_placeholder
# STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ------------------------------------------------------------------------------
# 4. Transactional Notifications (Email / SMS)
# ------------------------------------------------------------------------------
# Resend API Key for transactional order confirmation & tracking emails
RESEND_API_KEY=re_placeholder_api_key
EMAIL_FROM="Vélure Atelier <concierge@velure-atelier.com>"
ADMIN_NOTIFICATION_EMAIL=atelier-ops@velure-atelier.com

# ------------------------------------------------------------------------------
# 5. Security & Rate Limiting (Optional / Production)
# ------------------------------------------------------------------------------
# Upstash Redis for distributed rate limiting on public API endpoints (optional)
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-placeholder
