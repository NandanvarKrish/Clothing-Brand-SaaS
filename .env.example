# ==============================================================================
# Vélure Atelier — Environment Configuration (.env.example)
#
# IMPORTANT:
# 1. Copy this file to .env.local for local development:
#    cp .env.example .env.local
# 2. Never commit actual secret keys or .env.local to version control.
# 3. Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# 4. Variables without NEXT_PUBLIC_ are strictly server-only.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend & Database
# ------------------------------------------------------------------------------
# Your Supabase project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase public anonymous API key (safe for browser usage with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase Service Role Key (SERVER-ONLY - Bypasses Row Level Security)
# Used exclusively for background workers, payment webhooks, and admin operations.
# NEVER expose this key to client components or prefix with NEXT_PUBLIC_!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# Direct PostgreSQL database connection URL (Used for CLI migrations and scripts)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. Application & Site URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. Payment Gateway Integration & Provider Selection
# ------------------------------------------------------------------------------
# Active provider selection: 'mock' (default safe sandbox) | 'youpi' (experimental dev only) | 'razorpay'
PAYMENT_PROVIDER=mock

# Production-disable safeguard:
# In production (NODE_ENV=production), test adapters are strictly blocked unless explicitly allowed.
ALLOW_TEST_PAYMENTS=false

# --- Mock Sandbox Provider Configuration ---
# Secret used to sign and verify deterministic test webhooks
MOCK_WEBHOOK_SECRET=atelier_test_mock_webhook_secret_key_32c

# --- Evaluated Provider: YouPI PG V2 (Experimental Research Gateway) ---
# CRITICAL NOTICE: YOUPI PG V2 is an experimental research project relying on heuristic bank
# alert parsing. It is strictly prohibited from running with live customer funds in production.
# Core REST API endpoint (default port 6100):
YOUPI_API_URL=http://localhost:6100

# Merchant identifier UUID:
YOUPI_MERCHANT_ID=00000000-0000-0000-0000-000000000001

# Merchant Webhook Secret (used to verify inbound HMAC-SHA256 signatures & authenticate X-Merchant-Key):
YOUPI_WEBHOOK_SECRET=your_youpi_webhook_secret_key_placeholder

# Development auto-activation (bypasses manual WhatsApp pre-checkout verification in test runner):
YOUPI_AUTO_ACTIVATE=false

# Inbound Webhook Endpoint configured in merchant settings:
# https://your-domain.com/api/webhooks/payment?provider=youpi

# ------------------------------------------------------------------------------
# 4. Transactional Notifications (Email / SMS)
# ------------------------------------------------------------------------------
# Resend API Key for transactional order confirmation & tracking emails
RESEND_API_KEY=re_placeholder_api_key
EMAIL_FROM="Vélure Atelier <concierge@velure-atelier.com>"
ADMIN_NOTIFICATION_EMAIL=atelier-ops@velure-atelier.com

# ------------------------------------------------------------------------------
# 5. Security & Rate Limiting (Optional / Production)
# ------------------------------------------------------------------------------
# Upstash Redis for distributed rate limiting on public API endpoints (optional)
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-placeholder

# ------------------------------------------------------------------------------
# 6. Logistics & Shipping Provider Configuration
# ------------------------------------------------------------------------------
# Active shipping mode: 'manual' (default atelier concierge) | 'bluedart' | 'delhivery'
SHIPPING_PROVIDER=manual

# Secret for verifying carrier tracking status webhooks (HMAC-SHA256)
SHIPPING_WEBHOOK_SECRET=your_shipping_webhook_secret_placeholder
